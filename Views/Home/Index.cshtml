@{
    Layout = "~/Views/Shared/_UserLayout.cshtml";
}
@{
    var siteDetails = ViewBag.SiteDetails as HospitalManagement.Models.HeadSetting;
}

<!-- HERO-2
============================================= -->
<section id="hero-2" class="hero-section division">
        <!-- SLIDER -->
    <div class="slider blue-nav">
        <ul class="slides">
            @if (siteDetails != null)
            {
                <li id="slide-1">
                    <a href="@siteDetails.BannerLink1"><img src="@siteDetails.BannerImage1" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence"></a>
                </li>
                <li id="slide-2">
                    <a href="@siteDetails.BannerLink2"><img src="@siteDetails.BannerImage2" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence"></a>
                </li>
                <li id="slide-3">
                    <a href="@siteDetails.BannerLink3"><img src="@siteDetails.BannerImage3" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence"></a>
                </li>
                <li id="slide-4">
                    <a href="@siteDetails.BannerLink4"><img src="@siteDetails.BannerImage4" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence"></a>
                </li>
            }
        </ul>
    </div>	<!-- END SLIDER -->



</section>	<!-- END HERO-2 -->
<!-- INFO-4
============================================= -->
<section id="info-4" class=" pt-50 pb-50 info-section division">
    <div class="container">
        <div class="row d-flex align-items-center">


            <!-- INFO IMAGE -->
            <div class="col-lg-6">
                <div class="info-4-img mb-40 text-center ">
                    <img class="img-fluid" src="~/images/new-img/ambition.jpg" alt="info-image">
                </div>
            </div>


            <!-- INFO TEXT -->
            <div class="col-lg-6">
                <div class="txt-block mb-40 pc-30 ">

                    <!-- Section ID -->
                    <span class="section-id blue-color">Our Ambitions</span>

                    <!-- Title -->
                    <h1 class="h3-md steelblue-color">Our Patients Are Our Priority, Expert <span class="blue-text">Diagnostic & Specialist Care Under One Roof</span></h1>

                    <!-- Text -->
                    <p>
                        <b>Delivering accurate diagnosis, advanced imaging, and compassionate specialist care for every patient.</b></br></br>
                        Ratnakamal Medical Centre of Excellence is a trusted diagnostic and specialty healthcare centre dedicated to delivering <b>accurate, ethical, and patient-focused medical services</b>. Equipped with advanced diagnostic technology and guided by experienced specialists, we ensure reliable reports that support timely and informed clinical decisions.
                        </br>
                        Our centre offers comprehensive diagnostic and clinical support including <b>Pathology, Genetics, Fetal Medicine, MSK Ultrasound, General & 4D Ultrasonography</b>, along with <b>cardiac and respiratory investigations</b>—all in a safe, comfortable, and professional environment.
                    </p>
                    <!-- Button -->
                    <a href="@Url.Action("AboutUs","Home")" class="btn btn-blue blue-hover">Learn more</a>
                </div>
            </div>	<!-- END TEXT BLOCK -->
        </div>    <!-- End row -->
    </div>	   <!-- End container -->
</section>	<!-- END INFO-4 -->
<!-- SERVICES-4
============================================= -->
<section class=" pt-50 pb-50 division">
    <div class="container">


        <!-- SECTION TITLE -->
        <div class="row">
            <div class="col-lg-10 offset-lg-1 section-title">
                <!-- Section ID -->
                <span class="section-id blue-color">Our Services</span>

                <!-- Title 	-->
                <h3 class="h3-md steelblue-color">Services We <span class="blue-text">Offer</span></h3>


            </div>
        </div>


        <div class="row">
            @{
                var services = ViewBag.ServiceList as List<HospitalManagement.Models.MastHosService>;
            }
            @if (services != null && services.Count > 0)
            {
                @foreach (MastHosService service in services)
                {
                    <div class="col-md-6 col-lg-3">
                        <div class="sbox-4 ">

                            <!-- Image -->
                            <img class="img-fluid" src="@service.ServiceImage" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence" />

                            <!-- Text -->
                            <div class="sbox-4-txt">
                                <h5 class="h5-md steelblue-color"><a href="@Url.Action("Service","Home")">@service.ServiceName</a></h5>
                                <p>
                                    @service.ServiceShortDesc
                                </p>
                                @*<br /><a href="@Url.Action("Service","Home")" class="readmore blue-text">Read more <i class="fas fa-arrow-right"></i></a>*@
                            </div>

                        </div>
                    </div>
                }
            }


            <!-- Button -->
            <div class="col-md-12 text-center"><a href="@Url.Action("Service","Home")" class="btn btn-blue blue-hover mx-auto">See All Services</a></div>


        </div>	   <!-- End row -->
    </div>	   <!-- End container -->
</section>	<!-- END SERVICES-4 -->
<!-- ABOUT-5
============================================= -->
<section id="about-5" class="bg-lightblue pt-50 pb-50 about-section division">
    <div class="container">
        <div class="row d-flex align-items-center">


            <!-- IMAGE BLOCK -->
            <div class="col-lg-4">
                <div class="about-img text-center ">
                    <img class="img-fluid" src="~/images/Indian_model/doctor-face.png" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence">
                </div>
            </div>


            <!-- TEXT BLOCK -->
            <div class="col-lg-8">
                <div class="txt-block pc-30 ">

                    <!-- Section ID -->
                    <span class="section-id blue-color">Our Key Features</span>

                    <!-- Title -->
                    <h3 class="h3-md steelblue-color">Why <span class="blue-text">Choose Us?</span></h3>

                    <!-- Text -->

                    <div class="row">
                        <div class="col-md-6 col-xs-12 d-flex">
                            <img src="~/images/whyus1.png" width="80" height="80">
                            <span>
                                <span class="section-id m-0">Convenient Working Hours</span>
                                <p>Open <b>Monday to Saturday, 8:00 AM – 8:00 PM</b>, making it easy for patients to schedule diagnostic tests and consultations at a time that suits them.</p>
                            </span>
                        </div>
                        <div class="col-md-6 col-xs-12 d-flex">
                            <img src="~/images/whyus2.png" width="80" height="80">
                            <span>
                                <span class="section-id  m-0">Quick & Easy Appointments</span>
                                <p>Hassle-free appointment scheduling for <b>Ultrasound, ECG, Echocardiography, Holter, PFT, Pathology, and Genetic tests</b>, with minimal waiting time.</p>
                            </span>
                        </div>
                        <div class="col-md-6 col-xs-12 d-flex">
                            <img src="~/images/whyus3.png" width="80" height="80">
                            <span>
                                <span class="section-id  m-0">Accurate & Reliable Diagnostics</span>
                                <p>Trusted by patients and referring doctors for <b>precise reporting, advanced imaging, and ethical diagnostic practices</b> under one roof.</p>
                            </span>
                        </div>
                        <div class="col-md-6 col-xs-12 d-flex">
                            <img src="~/images/whyus4.png" width="80" height="80">
                            <span>
                                <span class="section-id  m-0">Clear Reports & Professional Guidance</span>
                                <p>Our specialists ensure <b>easy-to-understand reports</b> and guide patients on the next diagnostic steps, supporting informed medical decisions.</p>
                            </span>
                        </div>
                    </div>



                </div>
            </div>	<!-- END TEXT BLOCK -->


        </div>    <!-- End row -->
    </div>	   <!-- End container -->
</section>	<!-- END ABOUT-5 -->
<!-- SERVICES-4
============================================= -->
<section id="services-4" class="wide-tb-30 services-section division">
    <div class="container">


        <!-- SECTION TITLE -->
        <div class="row">
            <div class="col-lg-10 offset-lg-1 section-title">
                <!-- Section ID -->
                <span class="section-id blue-color">The Process</span>

                <!-- Title 	-->
                <h3 class="h3-md steelblue-color">How  <span class="blue-text">It Works</span></h3>


            </div>
        </div>
        <div class="col-md-12">
            <div class="row">


                <!-- SERVICE BOX #1 -->
                <div class="col-md-6 col-lg-3 hwitworksbg">
                    <div class="sbox-4">

                        <!-- Image -->
                        <img class="img-fluid" src="images/HowItWorks1.svg" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence" />

                        <!-- Text -->
                        <div class="sbox-4-txt">
                            <h5 class="h5-md steelblue-color"><a href="single-services.html">Choose Your Service</a></h5>
                            <p>Explore our range of tests—Pathology, Ultrasound, Genetics, Fetal Medicine, ECG, Echo, Holter, and PFT—and select the one you need.</p>

                        </div>

                    </div>
                </div>


                <!-- SERVICE BOX #2 -->
                <div class="col-md-6 col-lg-3 hwitworksbg">
                    <div class="sbox-4">

                        <!-- Image -->
                        <img class="img-fluid" src="images/HowItWorks2.svg" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence" />

                        <!-- Text -->
                        <div class="sbox-4-txt">
                            <h5 class="h5-md steelblue-color"><a href="single-services.html">Book An Appointment</a></h5>
                            <p>Pick your preferred time in seconds—online, by phone, or walk-in. We schedule tests as per your comfort.</p>


                        </div>

                    </div>
                </div>


                <!-- SERVICE BOX #3 -->
                <div class="col-md-6 col-lg-3 hwitworksbg">
                    <div class="sbox-4">

                        <!-- Image -->
                        <img class="img-fluid" src="images/HowItWorks3.svg" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence" />

                        <!-- Text -->
                        <div class="sbox-4-txt">
                            <h5 class="h5-md steelblue-color"><a href="single-services.html">Get Your Test Done</a></h5>
                            <p>From sample collection to imaging and doctor review, we guide you at every step with care and accuracy.</p>

                        </div>

                    </div>
                </div>


                <!-- SERVICE BOX #4 -->
                <div class="col-md-6 col-lg-3 hwitworksbg">
                    <div class="sbox-4">

                        <!-- Image -->
                        <img class="img-fluid" src="images/HowItWorks4.svg" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence" />

                        <!-- Text -->
                        <div class="sbox-4-txt">
                            <h5 class="h5-md steelblue-color"><a href="single-services.html">Receive Your Reports</a></h5>
                            <p>Get fast, reliable reports—digitally or printed. Share your feedback too; it helps us serve you even better.</p>
                        </div>

                    </div>
                </div>


            </div>
        </div>
    </div>	   <!-- End container -->
</section>	<!-- END SERVICES-4 -->
<!-- DOCTORS-1
============================================= -->
<section id="doctors-1" class=" pt-50 pb-50 doctors-section division bg-lightblue">
    <div class="container">


        <!-- SECTION TITLE -->
        <div class="row">
            <div class="col-lg-10 offset-lg-1 section-title">
                <span class="section-id blue-color">Our Specialists</span>
                <!-- Title 	-->
                <h3 class="h3-md steelblue-color">Meet Our <span class="blue-text">Specialized Doctors</span></h3>



            </div>
        </div>	 <!-- END SECTION TITLE -->
        <!-- TESTIMONIALS CONTENT -->
        <div class="row">
            <div class="col-md-12">
                <div class="owl-carousel owl-theme doctor-holder">
                    @{
                        var doctors = ViewBag.DoctorList as List<HospitalManagement.Models.MastDoctor>;
                    }
                    @if (doctors != null && doctors.Count > 0)
                    {
                        @foreach (MastDoctor doctor in doctors)
                        {
                            <div class="doctor-item">
                                <div class="doctor-1">

                                    <!-- Doctor Photo 
                                    <div class="hover-overlay text-center">
                                        <img class="img-fluid" src="" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence">
                                    </div>-->

                                    <!-- Doctor Meta -->
                                    <div class="doctor-meta">
                                        <h5 class="h5-sm steelblue-color">@doctor.DoctorName</h5>
                                        <span class="blue-color">@doctor.DoctorDegree</span>
                                        <p class="p-sm grey-color">
                                            @doctor.DoctorDesc
                                        </p>
                                        <div>
                                            <div class="footer-socials-links mt-20">
                                                <ul class="foo-socials text-center clearfix">

                                                    <li><a href="@doctor.FaceboolProfileLink" class="ico-facebook"><i class="fab fa-facebook-f"></i></a></li>
                                                    <li><a href="@doctor.LinkedInLink" class="ico-linkedin"><i class="fab fa-linkedin-in"></i></a></li>
                                                    <li><a href="@doctor.XLink" class="ico-twitter"><i class="fab fa-twitter"></i></a></li>
                                                </ul>
                                            </div>
                                        </div>

                                    </div>

                                </div>
                            </div>
                        }
                    }


                </div>
            </div>
        </div>
        <!-- END TESTIMONIALS CONTENT -->
        <!-- ALL DOCTORS BUTTON -->
        <div class="row">
            <div class="col-md-12 text-center">
                <div class="all-doctors mb-40">
                    <a href="@Url.Action("Doctor","Home")" class="btn btn-blue blue-hover">See All Doctors</a>
                </div>
            </div>
        </div>


    </div>	   <!-- End container -->
</section>	<!-- END DOCTORS-1 -->
