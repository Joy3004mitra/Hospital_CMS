<!-- TESTIMONIALS-2
============================================= -->
<section id="reviews-2" class="bg-blue pt-50 pb-100  reviews-section division">
    <div class="container">


        <!-- SECTION TITLE -->
        <div class="row">
            <div class="col-lg-10 offset-lg-1 section-title">

                <!-- Title 	-->
                <h3 class="h3-md steelblue-color">What Our Patients Say</h3>


            </div>
        </div>	 <!-- END SECTION TITLE -->
        <!-- TESTIMONIALS CONTENT -->
        <div class="row">
            <div class="col-md-12">
                <div class="owl-carousel owl-theme reviews-holder">
                    @{
                        var testimonials = ViewBag.TestimonialList as List<HospitalManagement.Models.MastHosTestimonials>;
                    }
                    @if (testimonials != null && testimonials.Count > 0)
                    {
                        @foreach (MastHosTestimonials testimonial in testimonials)
                        {
                            <div class="review-2">
                                <div class="review-txt text-center">

                                    <!-- Quote -->
                                    <div class="quote"><img src="~/images/quote.png" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence" /></div>

                                    <!-- Author Avatar -->
                                    <div class="testimonial-avatar">
                                        <img src="@testimonial.PatientImage" alt="Ratnakamal Medical Centre of Excellence" title="Ratnakamal Medical Centre of Excellence">
                                    </div>

                                    <!-- Testimonial Text -->
                                    <p>
                                        @testimonial.PatientComments
                                    </p>

                                    <!-- Testimonial Author -->
                                    <div class="review-author">
                                        <h5 class="h5-sm">@testimonial.PatientName</h5>
                                    </div>

                                </div>
                            </div>
                        }
                    }
                </div>
            </div>
        </div>	<!-- END TESTIMONIALS CONTENT -->


    </div>	   <!-- End container -->
</section>	 <!-- END TESTIMONIALS-2 -->
