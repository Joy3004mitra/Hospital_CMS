@model IEnumerable<HospitalManagement.Models.AppointmentHistory>

@{
    Layout = "~/Views/Shared/_Layout.cshtml";
}

@{
    var doctorAppointments = Model
        .Where(x => !string.IsNullOrWhiteSpace(x.DoctorName))
        .OrderByDescending(x => x.HeadAppointmentKey)
        .ToList();

    var departmentAppointments = Model
        .Where(x => !string.IsNullOrWhiteSpace(x.ServiceName))
        .OrderByDescending(x => x.HeadAppointmentKey)
        .ToList();
}

<div class="page-header space">
    <h2>Appointment History</h2>
</div>

<div class="content-scroll">

    <!-- ===================== -->
    <!-- SECTION 1: DOCTOR -->
    <!-- ===================== -->
    <h3 class="mt-4 text-success">Doctor Appointments</h3>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th style="display:none">ID</th>
                <th>Doctor Name</th>
                <th>Patient Name</th>
                <th>Email</th>
                <th>Contact No</th>
                <th>Appointment Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in doctorAppointments)
            {
                <tr>
                    <td style="display:none">@appointment.HeadAppointmentKey</td>
                    <td>@appointment.DoctorName.Trim()</td>
                    <td>@appointment.FullName</td>
                    <td>@appointment.Email</td>
                    <td>@appointment.PhoneNumber</td>
                    <td>@appointment.AppointmentDate?.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>

    <!-- ===================== -->
    <!-- SECTION 2: DEPARTMENT -->
    <!-- ===================== -->
    <h3 class="mt-5 text-primary">Department Appointments</h3>

    <table class="table table-bordered table-striped">
        <thead>
            <tr>
                <th style="display:none">ID</th>
                <th>Department</th>
                <th>Patient Name</th>
                <th>Email</th>
                <th>Contact No</th>
                <th>Appointment Date</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var appointment in departmentAppointments)
            {
                <tr>
                    <td style="display:none">@appointment.HeadAppointmentKey</td>
                    <td>@appointment.ServiceName.Trim()</td>
                    <td>@appointment.FullName</td>
                    <td>@appointment.Email</td>
                    <td>@appointment.PhoneNumber</td>
                    <td>@appointment.AppointmentDate?.ToString("dd/MM/yyyy")</td>
                </tr>
            }
        </tbody>
    </table>

</div>
